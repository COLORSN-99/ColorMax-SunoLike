{
  "name": "ColorMax",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "nuxt lint",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "safe-install": "bash scripts/safe-install.sh"
