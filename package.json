{
  "name": "colormax",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:web": "pnpm --filter @colormax/web dev",
    "build:web": "pnpm --filter @colormax/web build",
    "test:unit": "node --test packages/*/test/*.test.ts apps/web/test/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "axios": "^1.7.8",
    "cookie": "^1.0.2",
    "json5": "^2.2.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "c8": "^12.0.0",
    "playwright": "^1.64.1"
  }
}
